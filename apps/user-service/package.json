    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "@faker-js/faker": "^8.4.0",
    "@nestjs/cli": "^10.3.1",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.11"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
